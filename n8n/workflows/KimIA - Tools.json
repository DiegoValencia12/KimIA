      "id": "5d58e9b5-e26b-4b17-a5ab-57a4af6132e9",
      "name": "HTTP Search (Bing RSS)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        -80
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nif (input.error) {\n  const message = typeof input.error === 'string' ? input.error : input.error.message || JSON.stringify(input.error);\n  return [{ json: { content: `ERROR N8N (search): ${message}` } }];\n}\n\nconst statusCode = Number(input.statusCode || 0);\nif (statusCode >= 400) return [{ json: { content: `ERROR HTTP ${statusCode} en Bing RSS` } }];\n\nconst xml = String(input.body ?? input.data ?? '');\nif (xml.length < 50) return [{ json: { content: `ERROR: respuesta vacía (len=${xml.length})` } }];\n\nif (!/<rss\\b|<feed\\b/i.test(xml)) return [{ json: { content: `ERROR: Bing no devolvió RSS.` } }];\n\nconst decode = (value) => String(value ?? '').replace(/<!\\[CDATA\\[([\\s\\S]*?)\\]\\]>/g, '$1').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&#(\\d+);/g, (_, number) => String.fromCodePoint(Number(number))).replace(/<[^>]+>/g, '').replace(/\\s+/g, ' ').trim();\n\nconst results = [];\nconst itemRegex = /<item\\b[^>]*>([\\s\\S]*?)<\\/item>/gi;\nlet match;\n\nwhile ((match = itemRegex.exec(xml)) !== null && results.length < 10) {\n  const block = match[1];\n  const titleMatch = block.match(/<title\\b[^>]*>([\\s\\S]*?)<\\/title>/i);\n  const linkMatch = block.match(/<link\\b[^>]*>([\\s\\S]*?)<\\/link>/i);\n  if (!titleMatch || !linkMatch) continue;\n\n  const title = decode(titleMatch[1]);\n  const url = decode(linkMatch[1]);\n\n  if (title && /^https?:\\/\\//i.test(url)) results.push(`${results.length + 1}. ${title}\\n   ${url}`);\n}\n\nif (!results.length) return [{ json: { content: `Bing RSS sin resultados utilizables.` } }];\n\nreturn [{ json: { content: `Resultados (${results.length}):\\n\\n${results.join('\\n\\n')}` } }];"
      },
